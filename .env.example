# MongoDB connection string for Prisma
# Examples:
# Local MongoDB: mongodb://127.0.0.1:27017/btc_signal_engine?replicaSet=rs0&directConnection=true
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/btc_signal_engine?retryWrites=true&w=majority
DATABASE_URL="mongodb://127.0.0.1:27017/btc_signal_engine?replicaSet=rs0&directConnection=true"

# TypeSafe AI / Jev API Key (Optional: system degrades gracefully to neutral/WAIT when absent)
TYPESAFE_API_KEY=""

# CoinGecko Demo/Pro API Key (Optional: defaults to public API with rate-limiting backoff)
COINGECKO_API_KEY=""

# News / CryptoPanic API Key (Optional: defaults to public RSS feeds)
NEWS_API_KEY=""

# Application environment
NODE_ENV="development"

# Analysis settings
ANALYSIS_INTERVAL_MINUTES=5
PAPER_STARTING_BALANCE=10000
